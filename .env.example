# ============================================================================
# Interview.AI - environment template
# ============================================================================
# Copy this file to `.env` and fill in your own values:
#
#     copy .env.example .env          (Windows)
#     cp .env.example .env            (macOS / Linux)
#
# `.env` is git-ignored and must NEVER be committed, zipped or shared: it is
# the only place real secrets live. Everything below is a placeholder.
# ============================================================================


# ============================================================================
# DATABASE
# ============================================================================
# Empty  -> local SQLite file (backend/mock_interview.db). Use this for
#           development on your own machine.
# Set    -> PostgreSQL. THIS is what production must use.
#
# Supabase: Dashboard -> Project Settings -> Database -> Connection string -> URI
# Paste it with the password already filled in, for example:
#   DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
#
# An empty value means "use SQLite", so production must have this variable set.
# It is the only switch that decides where user data permanently lives.
DATABASE_URL=


# ============================================================================
# SESSION SECURITY
# ============================================================================
# Signing key for session cookies. REQUIRED in production: without it the app
# generates a key into backend/.flask_secret, which is lost on every redeploy
# and logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key

# Set to 1 on any HTTPS deployment so the session cookie is only ever sent over
# TLS. Leave empty for plain-HTTP local development (or you cannot log in).
COOKIE_SECURE=

# Set to 1 when the app runs behind exactly one reverse proxy that terminates
# HTTPS (Render, Railway, nginx, Heroku). This is what lets the app see the real
# scheme and client address: HSTS can be sent, verification emails contain the
# right URL, and rate limiting is per visitor instead of per proxy.
# Leave empty when clients connect straight to the process - a direct client
# could otherwise spoof those headers.
TRUST_PROXY=

# Set to 1 to redirect plain-HTTP requests to HTTPS (308 for writes, so a POST
# is never rewritten into a GET). Most hosts already do this at the edge.
FORCE_HTTPS=

# Optional comma-separated list of extra origins allowed to call the API with
# CORS. Only needed when the frontend is hosted separately from the API (for
# example GitHub Pages -> Render). Leave empty when both are on the same origin:
# the API is same-origin by default and never allows a wildcard.
ALLOWED_ORIGINS=


# ============================================================================
# SERVER
# ============================================================================
# Port to bind. Defaults to 5000 when empty. Hosts that inject their own PORT
# (Render, Railway) override this automatically.
PORT=5000

# Largest accepted request body in bytes (default 8 MB). Guards memory against
# oversized uploads and JSON blobs.
MAX_CONTENT_LENGTH=8388608


# ============================================================================
# LOCAL DEVELOPMENT SWITCHES  (leave empty in production)
# ============================================================================
# Public demo logins (admin@demo.com / user@demo.com) are seeded for local
# SQLite development and skipped automatically once DATABASE_URL is set.
# Set to 1 to create them even on PostgreSQL - NOT recommended.
SEED_DEMO_ACCOUNTS=

# Return email-verification / password-reset links inside API responses so local
# development works without SMTP. Disabled automatically on PostgreSQL, because
# on a public site the response *is* the reset token.
DEV_AUTH_LINKS=

# Werkzeug debugger. Keep empty unless debugging on your own machine: the
# debugger console allows remote code execution by design.
FLASK_DEBUG=


# ============================================================================
# EMAIL (verification + password reset)
# ============================================================================
# Without these, verification/reset emails are not sent (local development
# already works via DEV_AUTH_LINKS). Use a Gmail App Password, not the account
# password: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password


# ============================================================================
# GOOGLE SIGN-IN ("Continue with Google")
# ============================================================================
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Application type: Web application). Add every URL you serve from to both
# lists, e.g. for production:
#   Authorized JavaScript origin: https://your-app.onrender.com
#   Authorized redirect URI:      https://your-app.onrender.com/login.html
# The client id is public by design and is served to the browser by /api/config.
# The client secret is server-side only - never put it in HTML, CSS or JS.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret


# ============================================================================
# AI GRADING (optional)
# ============================================================================
# Leave blank to use the built-in rule-based grading engine. Set it to enable
# Gemini-backed grading.
GEMINI_API_KEY=your_gemini_api_key_here


# ============================================================================
# TESTS (optional)
# ============================================================================
# Point the test suite at PostgreSQL instead of SQLite:
#   cd backend && TEST_DATABASE_URL="postgresql://..." python -m unittest discover -s tests -t tests
# Never point this at the production database - the suite creates and deletes rows.
TEST_DATABASE_URL=
